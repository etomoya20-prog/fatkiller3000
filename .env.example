# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=

# Ключ OpenAI — им распознаются выгрузки и текстовые отчёты
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL на хосте (DB_HOST задан в docker-compose.yml)
DB_NAME=fatkiller3000
DB_USER=fatkiller
DB_PASSWORD=

# Telegram ID администраторов — доступ к /force_summary, /force_reminder, /chatid.
# Несколько — через запятую: ADMIN_IDS=123456789,987654321
# Свой ID можно узнать у @userinfobot.
ADMIN_IDS=

# Ограничить рассылку сводки конкретными группами. Пусто — сводка уходит
# во все группы, где состоит бот (обычно это и нужно).
# Несколько — через запятую. Узнать ID: команда /chatid в нужной группе.
GROUP_CHAT_ID=

# Расписание (время московское)
REMINDER_HOUR=21
REMINDER_MINUTE=0
# Ежедневная перекличка в группе: кто ещё не заполнил анкету.
# Если анкету заполнили все, бот молчит.
NUDGE_HOUR=19
NUDGE_MINUTE=0
SUMMARY_DAY=sun
SUMMARY_HOUR=20
SUMMARY_MINUTE=0

# Допустимое отклонение от нормы, при котором день считается соблюдённым
TOLERANCE=0.10
