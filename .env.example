# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=

# Ключ OpenAI — им распознаются выгрузки и текстовые отчёты
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL на хосте (DB_HOST задан в docker-compose.yml)
DB_NAME=fatkiller3000
DB_USER=fatkiller
DB_PASSWORD=

# Telegram ID администраторов — доступ к /force_summary, /force_reminder, /chatid.
# Несколько — через запятую: ADMIN_IDS=123456789,987654321
# Свой ID можно узнать у @userinfobot.
ADMIN_IDS=

# Telegram ID владельца бота. Только он получает запрос, когда бота добавляют
# в новую группу, и только после его «Разрешить» бот начинает там работать.
# Пусто — одобрять некому, в новых группах бот так и будет молчать.
OWNER_ID=

# Ограничить рассылку сводки конкретными группами. Пусто — сводка уходит
# во все группы, где состоит бот (обычно это и нужно).
# Несколько — через запятую. Узнать ID: команда /chatid в нужной группе.
GROUP_CHAT_ID=

# Расписание (время московское)
REMINDER_HOUR=21
REMINDER_MINUTE=0
# Ежедневная перекличка в группе: кто ещё не заполнил анкету.
# Если анкету заполнили все, бот молчит.
NUDGE_HOUR=19
NUDGE_MINUTE=0
# Недельная сводка. Берёт 7 дней по вчерашний включительно, поэтому в
# понедельник утром это ровно прошлая неделя пн–вс.
SUMMARY_DAY=mon
SUMMARY_HOUR=10
SUMMARY_MINUTE=0

# Когда бот спрашивает в личке текущий вес. По умолчанию суббота, 10:00 МСК.
WEIGHIN_DAY=sat
WEIGHIN_HOUR=10
WEIGHIN_MINUTE=0

# С какой даты вести историю (YYYY-MM-DD). Дни до неё не попадают ни в выгрузку,
# ни в сводку и не считаются прогулами. Ставится после обнуления статистики:
# записей за те дни уже нет, и без этой границы вся история до обнуления
# выглядит сплошным прогулом у всех. Пустое значение — считать с самого начала.
HISTORY_START=

# Выгрузка в Google Sheets. Пустой GOOGLE_SHEET_ID выключает её целиком.
# ID берётся из ссылки: docs.google.com/spreadsheets/d/<ЭТО_ID>/edit
# Ключ сервисного аккаунта положить в secrets/google-service-account.json
# рядом с .env и расшарить таблицу на email сервисного аккаунта с правом
# редактирования — иначе он её не увидит.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=/app/secrets/google-service-account.json
# Вечером таблица обновляется каждые EXPORT_EVERY_MINUTES минут с EXPORT_FROM_HOUR
# до полуночи и ещё раз в 23:55: люди отвечают на напоминание (REMINDER_HOUR)
# уже вечером, и один ранний снимок стабильно терял бы весь день.
EXPORT_FROM_HOUR=20
EXPORT_EVERY_MINUTES=30

# Статья про дневник питания и трекеры — бот прикладывает её к оценкам по фото.
# Пустое значение убирает ссылку из ответа.
GUIDE_URL=https://medvisor.ru/articles/dieta-i-zdorovoe-pitanie/dnevnik-pitaniya/

# Допустимое отклонение от нормы, при котором день считается соблюдённым
TOLERANCE=0.10
